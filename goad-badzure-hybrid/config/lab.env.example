# config/lab.env.example
#
# Copier ce fichier vers config/lab.env (gitignored) et renseigner les valeurs réelles
# avant d'utiliser un script du dossier scripts/. Ne jamais committer config/lab.env :
# il contient des identifiants d'abonnement/tenant et une IP d'opérateur.

# ID de l'abonnement Azure cible (az account show --query id -o tsv).
# Sert de garde-fou : les scripts vérifient que la session az active pointe
# bien vers cet abonnement avant de continuer. Laisser vide pour désactiver
# cette vérification.
SUBSCRIPTION_ID=

# ID du tenant Microsoft Entra ID cible (az account show --query tenantId -o tsv)
TENANT_ID=

# Domaine par défaut du tenant, forme <...>.onmicrosoft.com
TENANT_DOMAIN=

# Nom du resource group hébergeant le lab GOAD (dc01, dc02, srv02, jumpbox)
RG_GOAD=

# Nom du resource group hébergeant les ressources BadZure
RG_BADZURE=

# Région Azure des VMs GOAD (dc01/dc02/srv02)
REGION_GOAD=

# Région Azure du jumpbox (séparée du reste de GOAD pour contourner le quota 4 vCPU/région)
REGION_JUMPBOX=

# Région Azure des ressources BadZure
REGION_BADZURE=

# IP publique de l'opérateur, utilisée pour restreindre les règles NSG SSH/RDP.
# Optionnel : laissée vide, elle est auto-détectée à chaque exécution des
# scripts. Ne renseigner explicitement que pour épingler une IP stable (ex.
# agent CI) plutôt que suivre l'IP réelle de la machine qui lance les scripts.
ALLOWED_IP=

# IP privée de dc01 dans le VNet GOAD (utilisée pour le tunnel WinRM via le jumpbox)
DC01_PRIVATE_IP=

# Utilisateur WinRM/local admin sur dc01 : "goadmin".
DC01_ADMIN_USER=goadmin

# Mot de passe correspondant à DC01_ADMIN_USER. Ne JAMAIS committer une
# valeur ici (fichier gitignored uniquement). Pour le récupérer :
#   cd GOAD/workspace/<instance>/provider/ && terraform output vm-config
DC01_ADMIN_PASSWORD=

# Utilisateur SSH du jumpbox : "goad".
JUMPBOX_SSH_USER=

# Chemin local vers la clé privée SSH du jumpbox, générée par GOAD au
# déploiement (ex. GOAD/workspace/<instance>/ssh_keys/ubuntu-jumpbox.pem).
JUMPBOX_SSH_KEY_PATH=

# App ID (client ID) d'un service principal app-only dédié aux appels Graph
# en écriture (création du compte sync-admin, attribution de rôle, nettoyage
# des apps ConnectSyncProvisioning en double). Requis par la politique
# Conditional Access du tenant, qui bloque toute authentification interactive
# scriptée. Laisser vide au premier déploiement : scripts/40-prepare-entra-connect.sh
# crée lui-même ce service principal (permissions Graph, consentement admin,
# secret) et affiche le nouveau secret une seule fois, à reporter ici ensuite.
GRAPH_CLIENT_ID=

# Secret client du service principal ci-dessus. Ne JAMAIS committer.
GRAPH_CLIENT_SECRET=
