# config/lab.env.example
#
# Copier ce fichier vers config/lab.env. Rien n'est requis : toutes les
# variables ci-dessous sont auto-détectées si laissées vides (compte az
# actif, régions par défaut, ressources créées par BadZure/GOAD). Une
# valeur explicite ici reste toujours prioritaire sur l'auto-détection.

# ID de l'abonnement Azure cible. Auto-détecté depuis la session az active
# (az account show). Sert de garde-fou si renseigné explicitement : les
# scripts vérifient alors que la session az active y correspond bien avant
# de continuer.
SUBSCRIPTION_ID=

# ID du tenant Microsoft Entra ID cible. Auto-détecté depuis la session az
# active.
TENANT_ID=

# Domaine par défaut du tenant, forme <...>.onmicrosoft.com. Auto-détecté
# via Microsoft Graph.
TENANT_DOMAIN=

# Région Azure des VMs GOAD (dc01/dc02/srv02). Par défaut : denmarkeast.
REGION_GOAD=

# Région Azure du jumpbox, séparée du reste de GOAD pour contourner le
# quota 4 vCPU/région. Par défaut : indiasouthcentral.
REGION_JUMPBOX=

# Région Azure des ressources BadZure. Par défaut : westus.
REGION_BADZURE=

# Utilisateur WinRM/local admin sur dc01. Par défaut : goadmin.
DC01_ADMIN_USER=

# Utilisateur SSH du jumpbox. Par défaut : goad.
JUMPBOX_SSH_USER=

# App ID (client ID) d'un service principal app-only dédié aux appels Graph
# en écriture (création du compte sync-admin, attribution de rôle, nettoyage
# des apps ConnectSyncProvisioning en double). Requis par la politique
# Conditional Access du tenant, qui bloque toute authentification interactive
# scriptée. Laisser vide au premier déploiement : scripts/40-prepare-entra-connect.sh
# crée lui-même ce service principal (permissions Graph, consentement admin,
# secret) et affiche le nouveau secret une seule fois, à reporter ici ensuite.
GRAPH_CLIENT_ID=

# Secret client du service principal ci-dessus.
GRAPH_CLIENT_SECRET=

# IP publique de l'opérateur, utilisée pour restreindre les règles NSG
# SSH/RDP. Auto-détectée à chaque exécution des scripts.
ALLOWED_IP=

# Nom du resource group hébergeant le lab GOAD (dc01, dc02, srv02, jumpbox).
# Dépend de l'ID d'instance choisi aléatoirement par goad.py à la création :
# auto-détecté après ./scripts/00-deploy.sh goad.
RG_GOAD=

# Nom du resource group hébergeant les ressources BadZure. BadZure choisit un
# nom aléatoire à chaque déploiement : auto-détecté après BadZure.py build.
RG_BADZURE=

# IP privée de dc01 dans le VNet GOAD (tunnel WinRM via le jumpbox).
# Auto-détectée depuis terraform output une fois GOAD déployé.
DC01_PRIVATE_IP=

# Mot de passe correspondant à DC01_ADMIN_USER. Auto-détecté depuis
# terraform output une fois GOAD déployé.
DC01_ADMIN_PASSWORD=

# Chemin local vers la clé privée SSH du jumpbox, générée par GOAD au
# déploiement. Le chemin dépend de l'ID d'instance GOAD (aléatoire) :
# auto-détecté une fois GOAD déployé.
JUMPBOX_SSH_KEY_PATH=
