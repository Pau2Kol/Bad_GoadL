# config/lab.env.example
#
# Copier ce fichier vers config/lab.env (gitignored) et renseigner les valeurs réelles
# avant d'utiliser un script du dossier scripts/. Ne jamais committer config/lab.env :
# il contient des identifiants d'abonnement/tenant et une IP d'opérateur.

# ID de l'abonnement Azure cible (az account show --query id -o tsv)
SUBSCRIPTION_ID=

# ID du tenant Microsoft Entra ID cible (az account show --query tenantId -o tsv)
TENANT_ID=

# Domaine par défaut du tenant, forme <...>.onmicrosoft.com
TENANT_DOMAIN=

# Nom du resource group hébergeant le lab GOAD (dc01, dc02, srv02, jumpbox)
RG_GOAD=

# Nom du resource group hébergeant les ressources BadZure
RG_BADZURE=

# Région Azure des VMs GOAD (dc01/dc02/srv02)
REGION_GOAD=

# Région Azure du jumpbox (séparée du reste de GOAD pour contourner le quota 4 vCPU/région)
REGION_JUMPBOX=

# Région Azure des ressources BadZure
REGION_BADZURE=

# IP publique de l'opérateur, utilisée pour restreindre les règles NSG SSH/RDP.
# Optionnel : laissée vide, elle est auto-détectée à chaque exécution
# (lib/common.sh, resolve_allowed_ip) via le même endpoint que
# BadZure/src/utils.py get_public_ip(). Ne renseigner explicitement que pour
# épingler une IP stable (ex. agent CI) plutôt que suivre l'IP réelle de la
# machine qui lance les scripts.
ALLOWED_IP=

# IP privée de dc01 dans le VNet GOAD (utilisée pour le tunnel WinRM via le jumpbox)
DC01_PRIVATE_IP=

# --- Ajoutées au Lot 3 (B4/B5 : pypsrp a besoin de credentials WinRM) ---

# Utilisateur WinRM/local admin sur dc01. Confirmé en conditions réelles
# (redéploiement complet, B4/B5) : "goadmin" (var.username du template GOAD)
# fonctionne pour la connexion WinRM directe, malgré l'inventaire GOAD-Light
# qui référence admin_user=administrator ailleurs (compte différent, sans
# rapport avec l'accès WinRM utilisé par pypsrp ici).
DC01_ADMIN_USER=goadmin

# Mot de passe correspondant à DC01_ADMIN_USER. Ne JAMAIS committer une valeur
# ici (fichier gitignored uniquement) ; pour dc01, GOAD-Light/providers/azure/windows.tf
# fixe un mot de passe par défaut pour un déploiement neuf, mais il a pu être
# changé depuis (rotation manuelle) — vérifier la valeur réellement active.
DC01_ADMIN_PASSWORD=

# Utilisateur SSH du jumpbox (défaut GOAD : "goad", cf. jumpbox_username dans
# GOAD/template/provider/azure/variables.tf) — laissé vide pour rester explicite.
JUMPBOX_SSH_USER=

# Chemin local vers la clé privée SSH du jumpbox générée par GOAD au déploiement
# (ex. ../ssh_keys/ubuntu-jumpbox.pem, relatif à l'endroit où `terraform apply`
# a été lancé — cf. GOAD/template/provider/azure/jumpbox.tf).
JUMPBOX_SSH_KEY_PATH=

# --- Ajoutées au Lot 4 (B6 : écritures Graph via SP app-only uniquement) ---

# App ID (client ID) d'un service principal app-only dédié aux appels Graph
# en écriture (création sync-admin, attribution de rôle, nettoyage apps
# ConnectSyncProvisioning). Requis par la politique Conditional Access du
# tenant (erreur 530035 sur toute auth interactive/device-code) — cf. spec
# §4/B6. À VÉRIFIER / prérequis explicitement manuel si ce SP n'existe pas
# encore : à créer une fois via le portail (spec §9), ce script ne le crée
# jamais lui-même. Laisser vide si non disponible : le script se limite alors
# aux vérifications en lecture (idempotence) et échoue proprement sur toute
# étape d'écriture nécessaire.
GRAPH_CLIENT_ID=

# Secret client du service principal ci-dessus (alternative : certificat,
# non implémenté dans ce lot — cf. CHANGELOG.md). Ne JAMAIS committer.
GRAPH_CLIENT_SECRET=
